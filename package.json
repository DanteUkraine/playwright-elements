{
  "name": "playwright-elements",
  "version": "1.18.2",
  "description": "Type-safe, component-based testing framework for Playwright. Create reusable, type-safe page objects with nested component hierarchies and custom methods. 70%+ reduction in boilerplate compared to pure Playwright.",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "bin": {
    "generate-index": "./lib/index.generator.cli.js"
  },
  "scripts": {
    "build": "tsc",
    "clean": "tsc --build --clean",
    "install:deps": "npm install --registry=https://registry.npmjs.org",
    "install:browsers": "npx playwright install --force chrome chromium msedge firefox webkit --with-deps",
    "test": "ts-mocha --exit",
    "test:single": "ts-mocha",
    "test:coverage": "c8 npm test",
    "integration:test": "npx playwright test integration.tests --config=integration.tests/playwright.config.ts",
    "test:coverage:integration": "npx c8 npx playwright test integration.tests --config=integration.tests/playwright.config.ts",
    "modify:readme": "npx ts-node prepare-readme.ts",
    "prepare": "husky install",
    "lint": "npx eslint ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanteUkraine/playwright-elements.git"
  },
  "keywords": [
    "Playwright",
    "playwright-elements",
    "playwright/test",
    "e2e-testing",
    "end-to-end-testing",
    "type-safe",
    "page-object",
    "component-testing",
    "web-testing",
    "automation",
    "typescript",
    "testing",
    "selenium-alternative",
    "cypress-alternative"
  ],
  "author": "Oleksandr Solomin",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/DanteUkraine/playwright-elements/issues"
  },
  "homepage": "https://github.com/DanteUkraine/playwright-elements#readme",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/chai": "^4.3.5",
    "@types/chai-as-promised": "^7.1.5",
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/mocha": "^10.0.6",
    "@types/node": "^22.13.1",
    "@types/yargs": "^17.0.33",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "c8": "^12.0.0",
    "chai": "^4.3.7",
    "eslint": "^8.57.1",
    "expect-type": "^1.2.0",
    "husky": "^8.0.3",
    "mocha": "^10.2.0",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "lodash.clonedeep": "^4.5.0",
    "yargs": "^17.7.2"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.44.x",
    "playwright-core": ">= 1.44.x"
  }
}
