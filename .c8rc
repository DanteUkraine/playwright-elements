{
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "test",
    "integration.tests",
    "lib",
    "**/*.spec.ts"
  ],
  "report-dir": "coverage",
  "reporter": ["text", "json", "html"],
  "src": "src",
  "lines": 80,
  "functions": 80,
  "branches": 80,
  "statements": 80
}
